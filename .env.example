# Schelling Point — environment template. Copy to .env.local and fill in.
# Never commit real values. Every variable here is read by src/** or scripts/**.

# ─── Database (src/lib/db, scripts/db-*.mjs) ────────────────────────────────
# Postgres is the only database on this branch. Local values match
# deploy/local/compose.yml (`npm run stack:up`).
# App connection: the APP_DB_USER role (LOGIN BYPASSRLS, not superuser).
DATABASE_URL=postgres://unconference_app:unconference_app@127.0.0.1:55432/unconference
# Owner/superuser connection for DDL: `npm run db:migrate` and `npm run db:seed`
# use it in preference to DATABASE_URL.
DATABASE_MIGRATION_URL=postgres://unconference:unconference@127.0.0.1:55432/unconference
# Application login role the migrator creates/updates (member of authenticated + anon).
APP_DB_USER=unconference_app
APP_DB_PASSWORD=
# `npm run db:seed` refuses to run unless this is "true". Never set in production.
ALLOW_SEED=

# ─── PDS (our own ATProto PDS; custodial + gathering accounts) ───────────────
# Public URL of the PDS (appears in DID documents).
PDS_URL=http://localhost:2583
# URL the app uses for admin/account XRPC calls (server-to-server; e.g. http://pds:3000 in a compose network).
PDS_INTERNAL_URL=http://localhost:2583
# PDS admin password (Basic auth user "admin"); must match the PDS's PDS_ADMIN_PASSWORD.
PDS_ADMIN_PASSWORD=
# Handle suffix without a leading dot: "test" locally, "unconference.events" in production.
PDS_HANDLE_DOMAIN=test
# The PLC directory our PDS writes to (its PDS_DID_PLC_URL). Identity events re-read our accounts' DID
# documents from here, fresh. Production: https://plc.directory (the default). Local stack:
PDS_PLC_URL=http://localhost:2582

# ─── Removed on this branch ─────────────────────────────────────────────────
# NEXT_PUBLIC_SUPABASE_URL, NEXT_PUBLIC_SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY
# and SUPABASE_URL are no longer read once Wave 2 deletes src/lib/supabase.

# ─── App ────────────────────────────────────────────────────────────────────
# Public origin, no trailing slash. Also decides the ATProto OAuth mode:
# https on a real hostname → confidential client; anything else → loopback.
NEXT_PUBLIC_APP_URL=http://localhost:3001
# Secret for cron endpoints and QR ticket signing.
CRON_SECRET=
TICKET_QR_SECRET=
NEXTAUTH_SECRET=
# Set to "true" to allow the seed-sessions endpoint in non-production.
ALLOW_SEED_SESSIONS=
# Map tiles: a MapLibre style URL (default OpenFreeMap "liberty", key-less). Build-time.
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
# Forward geocoder base for the map (organizers/hosts only). Default Nominatim; a local stub
# (http://localhost:…) is accepted outside production only when its origin matches PDS_URL & co.
GEOCODER_URL=

# ─── Email (Resend) ─────────────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# From address for sign-in links and notifications, e.g. "unconference.events <hello@unconference.events>".
MAIL_FROM=

# ─── Stripe ─────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_ALLOW_PLATFORM_CHARGES=

# ─── Integrations ───────────────────────────────────────────────────────────
API_KEY_BONFIRESAI=

# ─── Email sign-in abuse controls (src/lib/auth/custody.ts, client-ip.ts) ───
# `true` ONLY when the app is reachable solely through a proxy that overwrites
# X-Forwarded-For (Caddy in deploy/unconference). Enables per-IP limits.
TRUST_PROXY=
# Per rolling hour; defaults shown.
# AUTH_MAX_LINKS_PER_IP_HOUR=10
# AUTH_MAX_MINTS_PER_IP_HOUR=3
# AUTH_MAX_MINTS_GLOBAL_HOUR=60
# AUTH_MAX_LINKS_PER_EMAIL_HOUR=5

# ─── ATProto (src/lib/atproto) ──────────────────────────────────────────────
# HMAC key for the `sp_at_session` cookie. Any random string, 32+ chars.
#   openssl rand -base64 48
ATPROTO_SESSION_SECRET=
# AES-256-GCM key that wraps custodied app-passwords in at_credentials.
# EXACTLY 64 hex characters (32 bytes). Losing it orphans every custodied actor.
#   openssl rand -hex 32
ATPROTO_CUSTODY_KEY=
# Optional: a pre-provisioned ES256 private JWK (JSON, one line) for the
# confidential OAuth client. When unset, a key is generated once and stored in
# at_oauth_client_key (kid "schellingpoint-1").
ATPROTO_OAUTH_PRIVATE_JWK=
# Jetstream endpoint for the record indexer.
ATPROTO_JETSTREAM_URL=wss://jetstream2.us-east.bsky.network/subscribe
# PDS for custodial (app-password) accounts and the default write target.
ATPROTO_DEFAULT_PDS_URL=https://bsky.social
# XRPC host used for fallback handle resolution (com.atproto.identity.resolveHandle).
ATPROTO_HANDLE_RESOLVER=https://bsky.social

# --- Knowledge harvest (design §10.3) ----------------------------------------------------------
# Embeddings run on this box by default — no key, no cost, no transcript text leaving the server.
# Leave EMBEDDINGS_PROVIDER empty for the on-box model; `none` switches embeddings off entirely;
# `voyage`/`openai` are opt-in and need a model and a key, and do send transcript text away
# (disclosed to hosts). The corpus export works regardless; the Knowledge page shows what is on.
EMBEDDINGS_PROVIDER=          # (empty) = local | none | voyage | openai
EMBEDDINGS_MODEL=             # local default Xenova/bge-small-en-v1.5; else e.g. voyage-3
EMBEDDINGS_API_KEY=           # voyage / openai only
EMBEDDINGS_CACHE_DIR=         # where the local model lives; default <repo>/.models, /models in the image
EMBEDDINGS_OFFLINE=           # 1 = never reach the Hugging Face hub (set in the production image)
# Run `node scripts/fetch-embedding-model.mjs` once to populate the cache locally (~33 MB).
ANTHROPIC_API_KEY=            # answers, summaries and themes (Anthropic Messages API); without it
                              # the Knowledge page reads "Answers: not configured"
AI_CHAT_MODEL=claude-sonnet-5
