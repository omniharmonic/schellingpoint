{
  "name": "schelling-point-mvp",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "db:reset": "psql postgresql://postgres:postgres@127.0.0.1:54322/postgres -f supabase/schema.sql && psql postgresql://postgres:postgres@127.0.0.1:54322/postgres -f supabase/seed.sql",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:seed": "node scripts/db-seed.mjs",
    "stack:up": "docker compose -f deploy/local/compose.yml up -d",
    "stack:down": "docker compose -f deploy/local/compose.yml down",
    "test": "playwright test tests/event-api.spec.ts tests/creation-database.spec.ts tests/creation-reliability.spec.ts tests/ux-logic.spec.ts tests/members-api.spec.ts tests/atproto-records.spec.ts tests/atproto-auth.spec.ts tests/atproto-publish.spec.ts tests/atproto-participant.spec.ts tests/atproto-ingest.spec.ts tests/people-api.spec.ts tests/notifications.spec.ts tests/sessions-api.spec.ts tests/voting.spec.ts tests/auth-custody.spec.ts tests/db-baseline.spec.ts tests/admin-api.spec.ts",
    "test:sql": "for f in tests/sql/*.sql; do psql postgresql://postgres:postgres@127.0.0.1:54322/postgres -v ON_ERROR_STOP=1 -q -f $f || exit 1; done",
    "typecheck": "tsc --noEmit",
    "lexicons:validate": "node scripts/validate-lexicons.mjs",
    "atproto:indexer": "npx tsx scripts/atproto-indexer.ts",
    "atproto:audit": "npx tsx scripts/atproto-privacy-audit.ts"
  },
  "dependencies": {
    "@atproto/api": "^0.20.44",
    "@atproto/identity": "^0.5.13",
    "@atproto/jwk-jose": "^0.2.4",
    "@atproto/lexicon": "^0.7.14",
    "@atproto/oauth-client-node": "^0.5.7",
    "@atproto/syntax": "^0.7.6",
    "@noble/curves": "1.9.7",
    "@noble/hashes": "1.8.0",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-dropdown-menu": "^2.0.6",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.0.3",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.0.0",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.0.4",
    "@radix-ui/react-tooltip": "^1.0.7",
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.49.4",
    "@types/qrcode": "^1.5.6",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "date-fns": "^4.1.0",
    "framer-motion": "^11.0.8",
    "html5-qrcode": "^2.3.8",
    "jose": "^6.1.3",
    "lucide-react": "^0.468.0",
    "next": "15.5.25",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "^6.9.2",
    "stripe": "^20.3.1",
    "tailwind-merge": "^2.2.1",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^20",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.0.1",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.23.13",
    "typescript": "^5"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.28"
    }
  }
}
