PDS_ADMIN_PASSWORD=local-admin-password
PDS_PLC_ROTATION_KEY_K256_PRIVATE_KEY_HEX=e56594c3ba4c945a71b8315c4c43744d4f073716b455885ec3878bcd5d075431
