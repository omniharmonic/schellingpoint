# unconference.events production environment. Copy to deploy/unconference/.env on the server
# (mode 600) and keep an encrypted copy off the box. Never commit the real file.
# Generate secrets with the commands shown.

# --- Hosts --------------------------------------------------------------------------------
WEB_HOST=unconference.events
PDS_HOST=pds.unconference.events
# Handles are <name>.unconference.events. Choose once: it is written into every DID document.
PDS_HANDLE_DOMAIN=unconference.events
# Shown on the privacy and terms pages; must be a mailbox someone reads.
CONTACT_EMAIL=

# --- Database -----------------------------------------------------------------------------
POSTGRES_PASSWORD=          # openssl rand -hex 24
APP_DB_PASSWORD=            # openssl rand -hex 24

# --- PDS ----------------------------------------------------------------------------------
PDS_JWT_SECRET=             # openssl rand -hex 32
PDS_ADMIN_PASSWORD=         # openssl rand -hex 24
# The one secret that cannot be regenerated: losing it loses control of every DID on this PDS.
# openssl ecparam -name secp256k1 -genkey -noout -outform DER | tail -c +8 | head -c 32 | xxd -p -c 32
PDS_PLC_ROTATION_KEY_K256_PRIVATE_KEY_HEX=
# Resend SMTP (port 2465: Hetzner blocks 465 on new projects).
SMTP_URL=smtps://resend:<RESEND_API_KEY>@smtp.resend.com:2465
PDS_EMAIL_FROM=hello@unconference.events
PDS_CRAWLERS=https://bsky.network

# --- AppView ------------------------------------------------------------------------------
ATPROTO_SESSION_SECRET=     # openssl rand -hex 32
ATPROTO_CUSTODY_KEY=        # openssl rand -hex 32  (wraps custodial and gathering passwords)
ATPROTO_OAUTH_PRIVATE_JWK=  # optional; generated once and stored in the database when empty
TICKET_QR_SECRET=           # openssl rand -hex 32
UNSUBSCRIBE_SECRET=         # openssl rand -hex 32; optional, derived from ATPROTO_SESSION_SECRET if unset
CRON_SECRET=                # openssl rand -hex 32
APP_SECRETS_KEY=            # openssl rand -base64 32  (REQUIRED; seals organizer-supplied keys,
                            # e.g. a gathering's own answer-model key. Rotating it makes every
                            # stored key unreadable — organizers must paste theirs again.)
RESEND_API_KEY=             # Resend sending key restricted to unconference.events
MAIL_FROM=Unconference <hello@unconference.events>
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
ENS_RPC_URL=
# Map tiles (spec §8.2): a MapLibre style URL. Default is OpenFreeMap's key-less "liberty" style;
# set your own style/tile server here. Build-time (NEXT_PUBLIC_*): rebuild the image to change it.
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
# Forward geocoding base (organizers/hosts only, rate-limited). Default: Nominatim.
GEOCODER_URL=https://nominatim.openstreetmap.org/search

# --- Backups ------------------------------------------------------------------------------
# age public key; the private key stays with the operator, never on this server.
BACKUP_AGE_RECIPIENT=
BACKUP_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
BACKUP_S3_BUCKET=unconference-backups
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_HOUR_UTC=3

# --- Knowledge harvest (design §10.3) ----------------------------------------------------------
# Embeddings run on this box by default — no key, no cost, no transcript text leaving the server.
# Leave EMBEDDINGS_PROVIDER empty for the on-box model; `none` switches embeddings off entirely;
# `voyage`/`openai` are opt-in and need a model and a key, and do send transcript text away
# (disclosed to hosts). The corpus export works regardless; the Knowledge page shows what is on.
EMBEDDINGS_PROVIDER=          # (empty) = local | none | voyage | openai
EMBEDDINGS_MODEL=             # local default Xenova/bge-small-en-v1.5; else e.g. voyage-3
EMBEDDINGS_API_KEY=           # voyage / openai only
EMBEDDINGS_CACHE_DIR=         # where the local model lives; default <repo>/.models, /models in the image
EMBEDDINGS_OFFLINE=           # 1 = never reach the Hugging Face hub (set in the production image)
# Run `node scripts/fetch-embedding-model.mjs` once to populate the cache locally (~33 MB).
ANTHROPIC_API_KEY=            # fallback answer key for gatherings that have not set their own
                              # (Anthropic Messages API); without it and without a gathering key the
                              # Knowledge page reads "Answers: not configured"
AI_CHAT_MODEL=claude-sonnet-5
